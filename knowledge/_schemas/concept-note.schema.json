{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Concept note (schema v2)",
	"description": "One canonical GR concept written in our own voice on a depth ladder (entry, working, formal, research), with ways of explaining it, equations, misconceptions, checks, links to the visual network, and tutor moves. Source books never appear in prose; provenance is internal. See knowledge/_meta/writing-guide.md.",
	"type": "object",
	"required": [
		"schema_version", "id", "title", "domain", "tier", "aliases", "summary", "ways_in", "glossary", "prerequisites",
		"leads_to", "related", "key_equations", "derivations", "worked_examples", "teaching_arc", "analogies",
		"misconceptions", "checks", "notation_traps", "visuals", "tutor_moves", "history", "research_horizon", "provenance"
	],
	"additionalProperties": false,
	"properties": {
		"schema_version": { "enum": [2] },
		"id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
		"title": { "type": "string", "minLength": 3 },
		"domain": { "type": "string" },
		"tier": { "enum": ["prerequisite", "foundation", "core", "advanced", "frontier"] },
		"aliases": { "type": "array", "items": { "type": "string" } },
		"summary": { "type": "string", "minLength": 80, "description": "The idea in one breath: 2-3 entry-rung sentences a tutor can say aloud" },
		"ways_in": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/way" } },
		"glossary": {
			"type": "array",
			"description": "Every technical term the entry rung uses",
			"items": {
				"type": "object",
				"required": ["term", "plain_definition"],
				"additionalProperties": false,
				"properties": { "term": { "type": "string" }, "plain_definition": { "type": "string", "minLength": 15 } }
			}
		},
		"prerequisites": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "why", "needed_for"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string" },
					"why": { "type": "string", "minLength": 10 },
					"needed_for": { "$ref": "#/definitions/rung", "description": "Lowest rung that needs this prerequisite" }
				}
			}
		},
		"leads_to": { "type": "array", "items": { "$ref": "#/definitions/link" } },
		"related": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "relation"],
				"additionalProperties": false,
				"properties": { "id": { "type": "string" }, "relation": { "type": "string", "minLength": 5 } }
			}
		},
		"key_equations": { "type": "array", "items": { "$ref": "#/definitions/equation" } },
		"derivations": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["title", "rung", "goal", "steps", "result"],
				"additionalProperties": false,
				"properties": {
					"title": { "type": "string" },
					"rung": { "$ref": "#/definitions/rung" },
					"goal": { "type": "string" },
					"steps": { "type": "array", "minItems": 2, "items": { "type": "string" } },
					"result": { "type": "string" }
				}
			}
		},
		"worked_examples": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["title", "rung", "problem", "steps", "answer", "takeaway"],
				"additionalProperties": false,
				"properties": {
					"title": { "type": "string" },
					"rung": { "$ref": "#/definitions/rung" },
					"problem": { "type": "string", "minLength": 20 },
					"steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
					"answer": { "type": "string" },
					"takeaway": { "type": "string" }
				}
			}
		},
		"teaching_arc": {
			"type": "array",
			"minItems": 3,
			"items": {
				"type": "object",
				"required": ["step", "move", "why"],
				"additionalProperties": false,
				"properties": { "step": { "type": "string" }, "move": { "type": "string" }, "why": { "type": "string" } }
			}
		},
		"analogies": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["analogy", "explanation", "mapping", "limits", "rung"],
				"additionalProperties": false,
				"properties": {
					"analogy": { "type": "string" },
					"explanation": { "type": "string", "minLength": 40 },
					"mapping": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"required": ["this", "stands_for"],
							"additionalProperties": false,
							"properties": { "this": { "type": "string" }, "stands_for": { "type": "string" } }
						}
					},
					"limits": { "type": "string", "minLength": 20 },
					"rung": { "$ref": "#/definitions/rung" }
				}
			}
		},
		"misconceptions": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["belief", "why_tempting", "correction", "diagnostic_question", "rung"],
				"additionalProperties": false,
				"properties": {
					"belief": { "type": "string", "description": "In the learner's own words" },
					"why_tempting": { "type": "string" },
					"correction": { "type": "string" },
					"diagnostic_question": { "type": "string" },
					"rung": { "$ref": "#/definitions/rung" }
				}
			}
		},
		"checks": {
			"type": "array",
			"minItems": 3,
			"items": {
				"type": "object",
				"required": ["question", "answer", "rung", "targets_misconception"],
				"additionalProperties": false,
				"properties": {
					"question": { "type": "string" },
					"answer": { "type": "string", "description": "Fully worked" },
					"rung": { "$ref": "#/definitions/rung" },
					"targets_misconception": { "type": ["string", "null"], "description": "Exact belief text of a misconception" }
				}
			}
		},
		"notation_traps": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["issue", "course_choice", "variants"],
				"additionalProperties": false,
				"properties": { "issue": { "type": "string" }, "course_choice": { "type": "string" }, "variants": { "type": "string" } }
			}
		},
		"visuals": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "role", "priority", "sketch"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "description": "Visual catalog id naming the picture (knowledge/visuals/<id>.json)" },
					"role": { "type": "string", "description": "What this visual does for this concept" },
					"priority": { "enum": ["flagship", "core", "supporting"] },
					"sketch": { "type": ["string", "null"], "description": "Required when the visual is not in the catalog yet: what the learner sees, changes, and learns" }
				}
			}
		},
		"tutor_moves": {
			"type": "object",
			"required": ["opening_questions", "if_stuck", "common_questions", "demo_moments", "voice_notes", "level_switching"],
			"additionalProperties": false,
			"properties": {
				"opening_questions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
				"if_stuck": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["symptom", "move"],
						"additionalProperties": false,
						"properties": { "symptom": { "type": "string" }, "move": { "type": "string" } }
					}
				},
				"common_questions": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["question", "answer"],
						"additionalProperties": false,
						"properties": { "question": { "type": "string" }, "answer": { "type": "string" } }
					}
				},
				"demo_moments": { "type": "array", "items": { "type": "string" } },
				"voice_notes": { "type": "string" },
				"level_switching": { "type": "string" }
			}
		},
		"history": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["people", "year", "work", "contribution"],
				"additionalProperties": false,
				"properties": {
					"people": { "type": "array", "minItems": 1, "items": { "type": "string" } },
					"year": { "type": "string" },
					"work": { "type": ["string", "null"], "description": "Primary work title, only when certain" },
					"contribution": { "type": "string" }
				}
			}
		},
		"research_horizon": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["topic", "connection", "pointers"],
				"additionalProperties": false,
				"properties": {
					"topic": { "type": "string" },
					"connection": { "type": "string" },
					"pointers": { "type": "array", "items": { "type": "string" }, "description": "Author (year), *Title* - only what is certain" }
				}
			}
		},
		"provenance": {
			"type": "object",
			"required": ["source_units", "legacy_assets"],
			"additionalProperties": false,
			"description": "Internal only; never rendered or shown to learners",
			"properties": {
				"source_units": { "type": "array", "items": { "type": "string" }, "description": "book/unit, e.g. schutz/ch06" },
				"legacy_assets": { "type": "array", "items": { "type": "string" } }
			}
		},
		"review": {
			"type": "object",
			"additionalProperties": false,
			"properties": { "novice": { "$ref": "#/definitions/stage" }, "physics": { "$ref": "#/definitions/stage" } }
		}
	},
	"definitions": {
		"rung": { "enum": ["entry", "working", "formal", "research"] },
		"link": {
			"type": "object",
			"required": ["id", "why"],
			"additionalProperties": false,
			"properties": { "id": { "type": "string" }, "why": { "type": "string", "minLength": 10 } }
		},
		"way": {
			"type": "object",
			"required": ["id", "title", "rung", "explanation", "picture", "simplifies", "assumes", "visuals"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
				"title": { "type": "string" },
				"rung": { "$ref": "#/definitions/rung" },
				"explanation": { "type": "string", "minLength": 300 },
				"picture": { "type": ["string", "null"], "description": "A drawable image to hold in mind" },
				"simplifies": { "type": ["string", "null"], "description": "What this way leaves out or idealizes" },
				"assumes": { "type": "array", "items": { "type": "string" } },
				"visuals": { "type": "array", "items": { "type": "string" } }
			}
		},
		"equation": {
			"type": "object",
			"required": ["name", "latex", "meaning", "symbols", "conditions", "say_aloud", "rung"],
			"additionalProperties": false,
			"properties": {
				"name": { "type": "string" },
				"latex": { "type": "string" },
				"meaning": { "type": "string" },
				"symbols": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["symbol", "meaning"],
						"additionalProperties": false,
						"properties": { "symbol": { "type": "string" }, "meaning": { "type": "string" } }
					}
				},
				"conditions": { "type": ["string", "null"] },
				"say_aloud": { "type": "string" },
				"rung": { "$ref": "#/definitions/rung" }
			}
		},
		"stage": {
			"type": "object",
			"required": ["verdict", "fixes", "concerns"],
			"additionalProperties": false,
			"properties": {
				"verdict": { "enum": ["accurate", "fixed", "needs-attention"] },
				"fixes": { "type": "array", "items": { "type": "string" } },
				"concerns": { "type": "array", "items": { "type": "string" } }
			}
		}
	}
}
