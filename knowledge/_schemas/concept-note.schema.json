{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Concept note (schema v2)",
	"description": "One canonical GR concept written in our own voice on a depth ladder (entry, working, formal, research): objectives, distinct ways in, equations, derivations, examples, gradable problems and checks, observations, misconceptions, links to the visual network, and an executable tutor playbook. Every addressable item has a permanent id; addresses look like checks/<id> within a note or <concept>/checks/<id> across notes. Source books never appear in prose; provenance is internal. Custom keywords: x-format declares text format (md, latex, speech, plain); x-audience declares who may see a field (reader, tutor, author, system, internal). See knowledge/_meta/writing-guide.md.",
	"type": "object",
	"required": [
		"schema_version", "id", "title", "tagline", "domain", "tier", "status", "revision", "updated", "aliases", "summary",
		"objectives", "ways_in", "glossary", "pronunciations", "prerequisites", "leads_to", "related", "key_equations",
		"derivations", "worked_examples", "problems", "observations", "teaching_arc", "analogies", "misconceptions", "checks",
		"notation_traps", "visuals", "tutor_moves", "history", "research_horizon", "retired_ids", "provenance"
	],
	"additionalProperties": false,
	"properties": {
		"schema_version": { "enum": [2], "x-audience": "system" },
		"id": { "$ref": "#/definitions/kebab", "x-audience": "system" },
		"title": { "type": "string", "minLength": 3, "maxLength": 60, "x-format": "plain", "x-audience": "reader", "description": "Canonical name, e.g. Holonomy" },
		"tagline": { "type": "string", "minLength": 10, "maxLength": 90, "x-format": "plain", "x-audience": "reader" },
		"domain": { "$ref": "#/definitions/kebab", "x-audience": "system" },
		"tier": { "enum": ["prerequisite", "foundation", "core", "advanced", "frontier"], "x-audience": "system" },
		"status": { "enum": ["draft", "novice-reviewed", "physics-reviewed", "published", "retired"], "x-audience": "system", "description": "The runtime serves only published notes; an editor sets published after both reviews" },
		"revision": { "type": "integer", "minimum": 1, "x-audience": "system", "description": "Bumped on every learner-visible change" },
		"updated": { "$ref": "#/definitions/date", "x-audience": "system" },
		"aliases": { "type": "array", "items": { "type": "string" }, "x-audience": "system", "description": "True synonyms only; distinct objects get their own concept" },
		"summary": { "type": "string", "minLength": 80, "maxLength": 450, "x-format": "plain", "x-audience": "reader", "description": "The idea in one breath, entry rung, speakable, true for the first what-ifs" },
		"objectives": {
			"type": "array",
			"minItems": 2,
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "rung", "can_do", "evidenced_by"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"rung": { "$ref": "#/definitions/rung" },
					"can_do": { "type": "string", "x-format": "plain", "description": "One skill, starting with a verb: Explain, Predict, Compute, Derive, Estimate, Distinguish, Prove, State, Use, Sketch" },
					"evidenced_by": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/evidence_address" }, "description": "checks/ or problems/ at this objective's rung; worked examples demonstrate, they do not evidence" }
				}
			}
		},
		"ways_in": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/definitions/way" }, "x-audience": "reader" },
		"glossary": {
			"type": "array",
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "term", "forms", "say_as", "concept", "plain_definition"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"term": { "type": "string" },
					"forms": { "type": "array", "items": { "type": "string" }, "description": "Other surface forms: plurals, adjectives" },
					"say_as": { "type": ["string", "null"], "x-format": "speech", "description": "Pronunciation when unfamiliar, e.g. ho-LON-uh-mee" },
					"concept": { "anyOf": [{ "$ref": "#/definitions/kebab" }, { "type": "null" }], "description": "Registry concept that owns the term, if any" },
					"plain_definition": { "type": "string", "minLength": 15, "x-format": "plain" }
				}
			}
		},
		"pronunciations": {
			"type": "array",
			"x-audience": "tutor",
			"items": {
				"type": "object",
				"required": ["written", "spoken"],
				"additionalProperties": false,
				"properties": { "written": { "type": "string" }, "spoken": { "type": "string", "x-format": "speech" } }
			}
		},
		"prerequisites": {
			"type": "array",
			"x-audience": "system",
			"items": {
				"type": "object",
				"required": ["id", "why", "needed_for"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/kebab" },
					"why": { "type": "string", "minLength": 10, "x-format": "plain" },
					"needed_for": { "$ref": "#/definitions/rung", "description": "Lowest rung that needs it" }
				}
			}
		},
		"leads_to": {
			"type": "array",
			"x-audience": "system",
			"items": {
				"type": "object",
				"required": ["id", "why"],
				"additionalProperties": false,
				"properties": { "id": { "$ref": "#/definitions/kebab" }, "why": { "type": "string", "minLength": 10, "x-format": "md" } }
			}
		},
		"related": {
			"type": "array",
			"x-audience": "system",
			"items": {
				"type": "object",
				"required": ["id", "relation"],
				"additionalProperties": false,
				"properties": { "id": { "$ref": "#/definitions/kebab" }, "relation": { "type": "string", "minLength": 5, "x-format": "md" } }
			}
		},
		"key_equations": { "type": "array", "items": { "$ref": "#/definitions/equation" }, "x-audience": "reader" },
		"derivations": {
			"type": "array",
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "title", "rung", "goal", "steps", "result"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"title": { "type": "string", "x-format": "plain" },
					"rung": { "$ref": "#/definitions/rung" },
					"goal": { "type": "string", "x-format": "md" },
					"steps": { "type": "array", "minItems": 2, "items": { "type": "string", "x-format": "md" }, "description": "One move per step" },
					"result": { "type": "string", "x-format": "md" }
				}
			}
		},
		"worked_examples": {
			"type": "array",
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "title", "rung", "problem", "steps", "answer", "takeaway"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"title": { "type": "string", "x-format": "plain" },
					"rung": { "$ref": "#/definitions/rung" },
					"problem": { "type": "string", "minLength": 20, "x-format": "md" },
					"steps": { "type": "array", "minItems": 1, "items": { "type": "string", "x-format": "md" } },
					"answer": { "type": "string", "x-format": "md" },
					"takeaway": { "type": "string", "x-format": "md" }
				}
			}
		},
		"problems": {
			"type": "array",
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "rung", "difficulty", "type", "statement", "statement_spoken", "hints", "answer", "key_points", "numeric", "solution", "targets"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"rung": { "$ref": "#/definitions/rung" },
					"difficulty": { "enum": [1, 2, 3] },
					"type": { "enum": ["conceptual", "estimate", "calculation", "derivation", "proof", "computational", "open-ended"] },
					"statement": { "type": "string", "minLength": 20, "x-format": "md" },
					"statement_spoken": { "type": ["string", "null"], "x-format": "speech", "description": "Required when the statement contains math" },
					"hints": { "type": "array", "maxItems": 3, "items": { "type": "string", "x-format": "md" }, "description": "Gentlest first" },
					"answer": { "type": "string", "x-format": "md" },
					"key_points": { "type": "array", "minItems": 1, "items": { "type": "string", "x-format": "plain" } },
					"numeric": { "type": ["array", "null"], "items": { "$ref": "#/definitions/numeric_answer" } },
					"solution": { "type": "array", "minItems": 1, "items": { "type": "string", "x-format": "md" } },
					"targets": { "type": "array", "items": { "$ref": "#/definitions/item_id" }, "description": "ids of misconceptions this problem exposes" }
				}
			}
		},
		"observations": {
			"type": "array",
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "rung", "phenomenon", "connection", "numbers", "status", "reference"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"rung": { "$ref": "#/definitions/rung" },
					"phenomenon": { "type": "string", "x-format": "md" },
					"connection": { "type": "string", "x-format": "md" },
					"numbers": { "type": ["string", "null"], "x-format": "md" },
					"status": { "enum": ["measured", "proposed", "analogue", "thought-experiment"] },
					"reference": { "anyOf": [{ "$ref": "#/definitions/reference" }, { "type": "null" }] }
				}
			}
		},
		"teaching_arc": {
			"type": "array",
			"minItems": 3,
			"maxItems": 8,
			"x-audience": "tutor",
			"items": {
				"type": "object",
				"required": ["id", "rung", "step", "move", "why", "uses", "visual", "predict"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"rung": { "$ref": "#/definitions/rung" },
					"step": { "type": "string", "x-format": "plain" },
					"move": { "type": "string", "x-format": "md", "description": "The move in one or two sentences; point at content through uses instead of restating it" },
					"why": { "type": "string", "x-format": "md" },
					"uses": { "type": "array", "items": { "$ref": "#/definitions/address" } },
					"visual": { "anyOf": [{ "$ref": "#/definitions/visual_ref" }, { "type": "null" }] },
					"predict": { "type": ["string", "null"], "x-format": "speech", "description": "What the learner predicts before the reveal" }
				}
			}
		},
		"analogies": {
			"type": "array",
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "analogy", "rung", "explanation", "mapping", "limits"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"analogy": { "type": "string", "x-format": "plain" },
					"rung": { "$ref": "#/definitions/rung" },
					"explanation": { "type": "string", "minLength": 40, "x-format": "md" },
					"mapping": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"required": ["this", "stands_for"],
							"additionalProperties": false,
							"properties": { "this": { "type": "string", "x-format": "md" }, "stands_for": { "type": "string", "x-format": "md" } }
						}
					},
					"limits": { "type": "string", "minLength": 20, "x-format": "md" }
				}
			}
		},
		"misconceptions": {
			"type": "array",
			"maxItems": 8,
			"x-audience": "tutor",
			"items": {
				"type": "object",
				"required": ["id", "rung", "belief", "why_tempting", "correction", "diagnosed_by"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"rung": { "$ref": "#/definitions/rung" },
					"belief": { "type": "string", "x-format": "plain", "description": "In the learner's own words" },
					"why_tempting": { "type": "string", "x-format": "plain" },
					"correction": { "type": "string", "x-format": "plain", "description": "At most two sentences naming why the belief fails; the full reasoning lives in the diagnosing check's answer or a way" },
					"diagnosed_by": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/item_id" }, "description": "ids of checks that expose it" }
				}
			}
		},
		"checks": {
			"type": "array",
			"minItems": 2,
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "rung", "format", "question", "question_spoken", "answer", "key_points", "numeric", "hints", "targets", "visual"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"rung": { "$ref": "#/definitions/rung" },
					"format": { "enum": ["predict", "explain", "numeric", "choice", "evaluate-claim", "derive"] },
					"question": { "type": "string", "x-format": "md" },
					"question_spoken": { "type": ["string", "null"], "x-format": "speech", "description": "Required when the question contains math" },
					"answer": { "type": "string", "x-format": "md", "description": "Fully worked, as a chain of because-steps" },
					"key_points": { "type": "array", "minItems": 1, "items": { "type": "string", "x-format": "plain" }, "description": "What a correct answer must contain" },
					"numeric": { "type": ["array", "null"], "items": { "$ref": "#/definitions/numeric_answer" } },
					"hints": { "type": "array", "maxItems": 3, "items": { "type": "string", "x-format": "md" } },
					"targets": { "type": "array", "items": { "$ref": "#/definitions/item_id" }, "description": "ids of misconceptions this check exposes" },
					"visual": { "anyOf": [{ "$ref": "#/definitions/visual_ref" }, { "type": "null" }] }
				}
			}
		},
		"notation_traps": {
			"type": "array",
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "issue", "course_choice", "variants"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"issue": { "type": "string", "x-format": "plain" },
					"course_choice": { "type": "string", "x-format": "md", "description": "Must follow knowledge/notation/course-conventions.md" },
					"variants": { "type": "string", "x-format": "md", "description": "Generic: 'some texts...'; never a named source" }
				}
			}
		},
		"visuals": {
			"type": "array",
			"x-audience": "system",
			"items": {
				"type": "object",
				"required": ["id", "role", "priority", "sketch"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/kebab" },
					"role": { "type": "string", "x-format": "md" },
					"priority": { "enum": ["flagship", "core", "supporting"], "description": "Importance for this concept" },
					"sketch": { "type": ["string", "null"], "x-format": "md", "x-audience": "author", "description": "Required when the visual is not in the catalog yet" }
				}
			}
		},
		"tutor_moves": {
			"type": "object",
			"x-audience": "tutor",
			"required": ["opening_questions", "if_stuck", "common_questions", "voice_notes", "level_switching"],
			"additionalProperties": false,
			"properties": {
				"opening_questions": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["id", "question", "invites"],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/definitions/item_id" },
							"question": { "type": "string", "x-format": "speech", "description": "Names its setting; answerable by a novice" },
							"invites": { "enum": ["prediction", "reflection"] }
						}
					}
				},
				"if_stuck": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["id", "symptom", "move", "misconception", "uses"],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/definitions/item_id" },
							"symptom": { "type": "string", "x-format": "plain" },
							"move": { "type": "string", "x-format": "md" },
							"misconception": { "anyOf": [{ "$ref": "#/definitions/item_id" }, { "type": "null" }] },
							"uses": { "type": "array", "items": { "$ref": "#/definitions/address" } }
						}
					}
				},
				"common_questions": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["id", "rung", "question", "answer", "uses"],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/definitions/item_id" },
							"rung": { "$ref": "#/definitions/rung" },
							"question": { "type": "string", "x-format": "plain" },
							"answer": { "type": "string", "x-format": "md", "description": "Entry-rung answers are spoken: no math" },
							"uses": { "type": "array", "items": { "$ref": "#/definitions/address" } }
						}
					}
				},
				"voice_notes": { "type": ["string", "null"], "x-format": "md", "description": "Only guidance not already in say_aloud, symbols[].say, and pronunciations" },
				"level_switching": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["to_rung", "signals", "move", "uses"],
						"additionalProperties": false,
						"properties": {
							"to_rung": { "$ref": "#/definitions/rung" },
							"signals": { "type": "array", "minItems": 1, "items": { "type": "string", "x-format": "plain" } },
							"move": { "type": "string", "x-format": "md" },
							"uses": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/address" } }
						}
					}
				}
			}
		},
		"history": {
			"type": "array",
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "people", "year", "work", "contribution"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"people": { "type": "array", "minItems": 1, "items": { "type": "string" } },
					"year": { "type": "integer", "minimum": -600, "maximum": 2100 },
					"work": { "anyOf": [{ "$ref": "#/definitions/reference" }, { "type": "null" }] },
					"contribution": { "type": "string", "x-format": "md" }
				}
			}
		},
		"research_horizon": {
			"type": "array",
			"x-audience": "reader",
			"items": {
				"type": "object",
				"required": ["id", "topic", "connection", "references"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"topic": { "type": "string", "x-format": "plain" },
					"connection": { "type": "string", "x-format": "md" },
					"references": { "type": "array", "items": { "$ref": "#/definitions/reference" } }
				}
			}
		},
		"retired_ids": {
			"type": "array",
			"x-audience": "system",
			"description": "Ids removed after publication, kept so stored learner evidence still resolves; never reuse them",
			"items": {
				"type": "object",
				"required": ["collection", "id", "replaced_by"],
				"additionalProperties": false,
				"properties": {
					"collection": { "type": "string" },
					"id": { "$ref": "#/definitions/item_id" },
					"replaced_by": { "anyOf": [{ "$ref": "#/definitions/item_id" }, { "type": "null" }] }
				}
			}
		},
		"provenance": {
			"type": "object",
			"x-audience": "internal",
			"required": ["source_units", "legacy_assets"],
			"additionalProperties": false,
			"description": "Internal only; stripped from every runtime artifact",
			"properties": {
				"source_units": { "type": "array", "items": { "type": "string" }, "description": "book/unit, e.g. schutz/ch06" },
				"legacy_assets": { "type": "array", "items": { "type": "string" } }
			}
		},
		"review": {
			"type": "object",
			"x-audience": "internal",
			"additionalProperties": false,
			"properties": { "novice": { "$ref": "#/definitions/novice_stage" }, "physics": { "$ref": "#/definitions/physics_stage" } }
		}
	},
	"definitions": {
		"rung": { "enum": ["entry", "working", "formal", "research"] },
		"kebab": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
		"date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
		"item_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60, "description": "Permanent once published: change the text, never the id" },
		"address": {
			"type": "string",
			"pattern": "^([a-z0-9]+(-[a-z0-9]+)*/)?(ways_in|objectives|key_equations|derivations|worked_examples|problems|observations|checks|misconceptions|analogies|glossary|teaching_arc|notation_traps|opening_questions|if_stuck|common_questions|history|research_horizon)/[a-z0-9]+(-[a-z0-9]+)*$",
			"description": "<collection>/<item-id> within this note, or <concept-id>/<collection>/<item-id>"
		},
		"evidence_address": { "type": "string", "pattern": "^(checks|problems)/[a-z0-9]+(-[a-z0-9]+)*$" },
		"visual_ref": {
			"type": "object",
			"required": ["id", "preset", "tour"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/definitions/kebab" },
				"preset": { "anyOf": [{ "$ref": "#/definitions/item_id" }, { "type": "null" }] },
				"tour": { "anyOf": [{ "$ref": "#/definitions/item_id" }, { "type": "null" }] }
			}
		},
		"numeric_answer": {
			"type": "object",
			"required": ["quantity", "value", "unit", "sign", "abs_tol", "rel_tol", "modulo"],
			"additionalProperties": false,
			"properties": {
				"quantity": { "type": "string", "x-format": "plain" },
				"value": { "type": "number" },
				"unit": { "type": "string", "description": "A unit from the validator's unit table, e.g. rad, deg, turn, km, km^2, m, s, yr, kg, M_sun, Hz, eV, mas/yr, 1" },
				"sign": { "enum": ["signed", "magnitude"], "description": "signed: positive in the note's stated sense" },
				"abs_tol": { "type": ["number", "null"], "minimum": 0 },
				"rel_tol": { "type": ["number", "null"], "minimum": 0 },
				"modulo": { "type": ["number", "null"], "description": "Period for angles or phases, in the answer's unit (e.g. 360 for deg)" }
			}
		},
		"reference": {
			"type": "object",
			"required": ["authors", "more_authors", "year", "title", "venue", "doi", "arxiv", "kind", "verified"],
			"additionalProperties": false,
			"properties": {
				"authors": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Real names only, never 'et al.'" },
				"more_authors": { "type": "boolean", "description": "true when authors lists only the first few" },
				"year": { "type": "integer", "minimum": -600, "maximum": 2100 },
				"title": { "type": ["string", "null"] },
				"venue": { "type": ["string", "null"], "description": "Journal with volume and pages, publisher, or institution" },
				"doi": { "type": ["string", "null"] },
				"arxiv": { "type": ["string", "null"] },
				"kind": { "enum": ["paper", "review", "book", "lecture-notes", "thesis", "talk"] },
				"verified": { "type": "boolean", "description": "true only after the physics reviewer confirmed authors, year, title, and venue against a reliable record" }
			}
		},
		"way": {
			"type": "object",
			"required": ["id", "title", "kind", "rung", "question", "continues", "gist", "recap", "explanation", "try_it", "takeaway", "picture", "simplifies", "assumes", "visuals", "refs"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/definitions/item_id" },
				"title": { "type": "string", "x-format": "plain" },
				"kind": { "enum": ["picture", "operational", "calculation", "structure", "historical-puzzle", "bridge", "contrast"] },
				"rung": { "$ref": "#/definitions/rung" },
				"question": { "type": "string", "minLength": 15, "x-format": "plain", "description": "The question this way answers; different for every way" },
				"continues": { "type": "array", "items": { "$ref": "#/definitions/item_id" }, "description": "ids of earlier ways this one climbs from; empty only for entry ways" },
				"gist": { "type": ["string", "null"], "maxLength": 300, "x-format": "speech", "x-audience": "tutor", "description": "Only when the tutor's spoken opener must differ from the takeaway, e.g. posing the question as a prediction; otherwise null and the tutor speaks the takeaway" },
				"recap": { "type": ["string", "null"], "maxLength": 700, "x-format": "md", "description": "Restates any test, rule, or name from another way or prerequisite; hidden when the reader arrives in sequence" },
				"explanation": { "type": "string", "minLength": 300, "x-format": "md" },
				"try_it": { "type": ["string", "null"], "x-format": "md", "description": "A hands-on test the reader can actually do, with what they should see" },
				"takeaway": { "type": "string", "maxLength": 240, "x-format": "plain", "description": "The sentence the reader should be able to say back; for entry ways, in a beginner's words" },
				"picture": { "type": ["string", "null"], "x-format": "md", "description": "Only when the way cites no visual; otherwise null" },
				"simplifies": { "type": ["string", "null"], "x-format": "md", "description": "Reader-facing at this way's rung" },
				"assumes": { "type": "array", "items": { "$ref": "#/definitions/kebab" } },
				"visuals": { "type": "array", "items": { "$ref": "#/definitions/visual_ref" } },
				"refs": { "type": "array", "items": { "$ref": "#/definitions/address" } }
			}
		},
		"equation": {
			"type": "object",
			"required": ["id", "name", "rung", "latex", "meaning", "symbols", "conditions", "say_aloud", "justified_by"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/definitions/item_id" },
				"name": { "type": "string", "x-format": "plain" },
				"rung": { "$ref": "#/definitions/rung" },
				"latex": { "type": "string", "x-format": "latex" },
				"meaning": { "type": "string", "x-format": "md" },
				"symbols": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["symbol", "meaning", "say"],
						"additionalProperties": false,
						"properties": {
							"symbol": { "type": "string", "x-format": "latex" },
							"meaning": { "type": "string", "x-format": "md" },
							"say": { "type": "string", "x-format": "speech" }
						}
					}
				},
				"conditions": { "type": ["string", "null"], "x-format": "md" },
				"say_aloud": { "type": "string", "x-format": "speech" },
				"justified_by": { "type": "string", "description": "derivations/<id> (same or lower rung), a prerequisite concept id, or \"stated\"" }
			}
		},
		"novice_stage": {
			"type": "object",
			"required": ["verdict", "date", "reviewed_revision", "retell_attempt", "stumbles", "fixes", "concerns"],
			"additionalProperties": false,
			"properties": {
				"verdict": { "enum": ["accurate", "fixed", "needs-attention"] },
				"date": { "$ref": "#/definitions/date" },
				"reviewed_revision": { "type": "integer", "minimum": 1 },
				"retell_attempt": { "type": "string", "description": "The persona's retelling after one reading, before fixes" },
				"rereads": {
					"type": "array",
					"description": "Later novice readings of learner-visible text that another stage changed after this review",
					"items": {
						"type": "object",
						"required": ["date", "revision", "read", "stumbles", "fixes"],
						"additionalProperties": false,
						"properties": {
							"date": { "$ref": "#/definitions/date" },
							"revision": { "type": "integer", "minimum": 1, "description": "The note revision after this re-read" },
							"read": { "type": "array", "items": { "type": "string" }, "description": "Paths of the changed text that was read, as note_diff.py prints them" },
							"stumbles": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["quote", "problem", "rewrite"],
									"additionalProperties": false,
									"properties": { "quote": { "type": "string" }, "problem": { "type": "string" }, "rewrite": { "type": "string" } }
								}
							},
							"fixes": { "type": "array", "items": { "type": "string" } }
						}
					}
				},
				"stumbles": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["quote", "problem", "rewrite"],
						"additionalProperties": false,
						"properties": { "quote": { "type": "string" }, "problem": { "type": "string" }, "rewrite": { "type": "string" } }
					}
				},
				"fixes": { "type": "array", "items": { "type": "string" } },
				"concerns": { "type": "array", "items": { "type": "string" } }
			}
		},
		"physics_stage": {
			"type": "object",
			"required": ["verdict", "date", "reviewed_revision", "verification", "counterexamples", "fixes", "concerns"],
			"additionalProperties": false,
			"properties": {
				"verdict": { "enum": ["accurate", "fixed", "needs-attention"] },
				"date": { "$ref": "#/definitions/date" },
				"reviewed_revision": { "type": "integer", "minimum": 1 },
				"verification": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["claim", "method", "result"],
						"additionalProperties": false,
						"properties": { "claim": { "type": "string" }, "method": { "type": "string" }, "result": { "type": "string" } }
					}
				},
				"counterexamples": { "type": "array", "items": { "type": "string" }, "description": "Standard counterexamples tried against the note's general statements, and the outcome" },
				"diff_checks": {
					"type": "array",
					"description": "Later accuracy checks of learner-visible text that another stage changed after this review",
					"items": {
						"type": "object",
						"required": ["date", "revision", "verification", "fixes"],
						"additionalProperties": false,
						"properties": {
							"date": { "$ref": "#/definitions/date" },
							"revision": { "type": "integer", "minimum": 1, "description": "The note revision after this check" },
							"verification": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["claim", "method", "result"],
									"additionalProperties": false,
									"properties": { "claim": { "type": "string" }, "method": { "type": "string" }, "result": { "type": "string" } }
								}
							},
							"fixes": { "type": "array", "items": { "type": "string" } }
						}
					}
				},
				"fixes": { "type": "array", "items": { "type": "string" } },
				"concerns": { "type": "array", "items": { "type": "string" } }
			}
		}
	}
}
