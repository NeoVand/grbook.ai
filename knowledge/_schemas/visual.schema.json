{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Visual (schema v2): a component contract for a diagram, widget, animation, or 3D demo",
	"description": "One reusable picture in the visual network. Typed params (with availability constraints), presets, and readouts (with sense, range, and precision) define its state; tours, beats, and tests refer to that state, so the tutor can drive it and tests compile to unit tests. Addresses: visual:<id>, visual:<id>/presets/<id>, visual:<id>/tours/<id>/beats/<id>. Written in our own voice; sources appear only in provenance. See knowledge/_meta/writing-guide.md section 10.",
	"type": "object",
	"required": [
		"schema_version", "id", "title", "kind", "priority", "status", "revision", "updated", "component", "rungs", "makes_visible",
		"picture", "print_figure", "variants", "params", "presets", "readouts", "tours", "design_rules", "model", "serves",
		"builds_on", "leads_to", "variant_of", "accessibility", "starting_material", "provenance"
	],
	"additionalProperties": false,
	"properties": {
		"schema_version": { "enum": [2], "x-audience": "system" },
		"id": { "$ref": "#/definitions/kebab", "x-audience": "system", "description": "Names the picture, not the concept" },
		"title": { "type": "string", "minLength": 3, "maxLength": 70, "x-format": "plain", "x-audience": "reader" },
		"kind": { "$ref": "#/definitions/form", "x-audience": "system" },
		"priority": { "enum": ["flagship", "core", "supporting"], "x-audience": "author", "description": "Catalog-wide build priority" },
		"status": { "enum": ["proposed", "specified", "prototype", "built", "published", "retired"], "x-audience": "system" },
		"revision": { "type": "integer", "minimum": 1, "x-audience": "system" },
		"updated": { "$ref": "#/definitions/date", "x-audience": "system" },
		"component": { "type": ["string", "null"], "x-audience": "system", "description": "Svelte module path; required once built" },
		"rungs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/rung" }, "x-audience": "system" },
		"makes_visible": { "type": "string", "minLength": 60, "x-format": "md", "x-audience": "author" },
		"picture": {
			"type": "object",
			"x-audience": "reader",
			"required": ["caption", "composition", "elements"],
			"additionalProperties": false,
			"properties": {
				"caption": { "type": "string", "minLength": 20, "x-format": "plain", "description": "One sentence a novice understands" },
				"composition": { "type": "string", "minLength": 60, "x-format": "md", "x-audience": "author" },
				"elements": {
					"type": "array",
					"minItems": 2,
					"x-audience": "author",
					"items": {
						"type": "object",
						"required": ["element", "depicts"],
						"additionalProperties": false,
						"properties": { "element": { "type": "string", "x-format": "plain" }, "depicts": { "type": "string", "x-format": "plain" } }
					}
				}
			}
		},
		"print_figure": {
			"type": "object",
			"x-audience": "author",
			"required": ["description", "labels", "aspect", "alt_text"],
			"additionalProperties": false,
			"properties": {
				"description": { "type": "string", "x-format": "md" },
				"labels": { "type": "array", "items": { "type": "string" } },
				"aspect": { "type": "string", "pattern": "^\\d+:\\d+$" },
				"alt_text": { "type": "string", "x-format": "plain", "x-audience": "reader" }
			}
		},
		"variants": {
			"type": "array",
			"minItems": 1,
			"x-audience": "system",
			"items": {
				"type": "object",
				"required": ["id", "form", "description", "fallback"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"form": { "$ref": "#/definitions/form" },
					"description": { "type": "string", "minLength": 20, "x-format": "md" },
					"fallback": { "type": "boolean", "description": "Used when richer variants cannot run" }
				}
			}
		},
		"params": {
			"type": "array",
			"x-audience": "system",
			"items": {
				"type": "object",
				"required": ["id", "label", "type", "options", "min", "max", "step", "unit", "default", "available_when", "effect"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"label": { "type": "string", "x-format": "plain" },
					"type": { "enum": ["enum", "number", "integer", "boolean", "path", "progress"] },
					"options": {
						"type": ["array", "null"],
						"items": {
							"type": "object",
							"required": ["value", "label", "available_when"],
							"additionalProperties": false,
							"properties": {
								"value": { "type": "string" },
								"label": { "type": "string" },
								"available_when": { "$ref": "#/definitions/constraint" }
							}
						}
					},
					"min": { "type": ["number", "null"] },
					"max": { "type": ["number", "null"] },
					"step": { "type": ["number", "null"] },
					"unit": { "type": ["string", "null"] },
					"default": {},
					"available_when": { "$ref": "#/definitions/constraint" },
					"effect": { "type": "string", "x-format": "md" }
				}
			}
		},
		"presets": {
			"type": "array",
			"minItems": 1,
			"x-audience": "system",
			"items": {
				"type": "object",
				"required": ["id", "label", "state"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"label": { "type": "string", "x-format": "plain" },
					"state": { "type": "object", "description": "param id -> value; unspecified params take defaults; no preset key" }
				}
			}
		},
		"readouts": {
			"type": "array",
			"x-audience": "system",
			"items": {
				"type": "object",
				"required": ["id", "label", "unit", "sense", "range", "decimals", "visible_when", "say", "say_negative"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"label": { "type": "string", "x-format": "plain" },
					"unit": { "type": ["string", "null"] },
					"sense": { "type": ["string", "null"], "x-format": "plain", "description": "What positive means, for signed quantities" },
					"range": { "type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "description": "Branch or range of reported values, lower bound exclusive for angles, e.g. [-180, 180]" },
					"decimals": { "type": "integer", "minimum": 0, "maximum": 12 },
					"visible_when": { "enum": ["always", "on-complete", "on-demand"] },
					"say": { "type": "string", "x-format": "speech", "description": "Template with {value} or {abs}" },
					"say_negative": { "type": ["string", "null"], "x-format": "speech", "description": "Template for negative values, with {abs}; required for signed readouts" }
				}
			}
		},
		"tours": {
			"type": "array",
			"minItems": 1,
			"x-audience": "tutor",
			"items": {
				"type": "object",
				"required": ["id", "for_concept", "rung", "beats"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"for_concept": { "anyOf": [{ "$ref": "#/definitions/kebab" }, { "type": "null" }] },
					"rung": { "$ref": "#/definitions/rung" },
					"beats": { "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/beat" } }
				}
			}
		},
		"design_rules": {
			"type": "array",
			"minItems": 1,
			"x-audience": "author",
			"items": {
				"type": "object",
				"required": ["id", "rule", "because", "misconception"],
				"additionalProperties": false,
				"properties": {
					"id": { "$ref": "#/definitions/item_id" },
					"rule": { "type": "string", "x-format": "md" },
					"because": { "type": "string", "x-format": "md" },
					"misconception": { "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/misconceptions/[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }] }
				}
			}
		},
		"model": {
			"type": "object",
			"x-audience": "author",
			"required": ["summary", "equations", "method", "tests"],
			"additionalProperties": false,
			"properties": {
				"summary": { "type": "string", "minLength": 20, "x-format": "md" },
				"equations": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["id", "label", "latex", "say", "conditions"],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/definitions/item_id" },
							"label": { "type": "string", "x-format": "plain" },
							"latex": { "type": "string", "x-format": "latex" },
							"say": { "type": "string", "x-format": "speech" },
							"conditions": { "type": ["string", "null"], "x-format": "md" }
						}
					}
				},
				"method": { "type": ["string", "null"], "x-format": "md" },
				"tests": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["id", "state", "expect", "expect_hidden", "note"],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/definitions/item_id" },
							"state": { "type": "object", "description": "Must contain preset; other keys override params; set progress to 1 when expecting on-complete readouts" },
							"expect": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["readout", "value", "abs_tol", "rel_tol"],
									"additionalProperties": false,
									"properties": {
										"readout": { "type": "string" },
										"value": { "type": "number" },
										"abs_tol": { "type": ["number", "null"] },
										"rel_tol": { "type": ["number", "null"] }
									}
								}
							},
							"expect_hidden": { "type": "array", "items": { "type": "string" }, "description": "Readouts that must not be visible in this state" },
							"note": { "type": "string", "x-format": "md" }
						}
					}
				}
			}
		},
		"serves": {
			"type": "array",
			"minItems": 1,
			"x-audience": "system",
			"items": {
				"type": "object",
				"required": ["concept", "uses"],
				"additionalProperties": false,
				"properties": { "concept": { "$ref": "#/definitions/kebab" }, "uses": { "type": "string", "x-format": "md" } }
			}
		},
		"builds_on": { "type": "array", "items": { "$ref": "#/definitions/kebab" }, "x-audience": "system" },
		"leads_to": { "type": "array", "items": { "$ref": "#/definitions/kebab" }, "x-audience": "system" },
		"variant_of": { "anyOf": [{ "$ref": "#/definitions/kebab" }, { "type": "null" }], "x-audience": "system" },
		"accessibility": {
			"type": "object",
			"x-audience": "reader",
			"required": ["summary", "static_alt", "keyboard"],
			"additionalProperties": false,
			"properties": {
				"summary": { "type": "string", "minLength": 40, "x-format": "md" },
				"static_alt": { "type": "string", "x-format": "plain" },
				"keyboard": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["key", "action"],
						"additionalProperties": false,
						"properties": { "key": { "type": "string" }, "action": { "type": "string" } }
					}
				}
			}
		},
		"starting_material": {
			"type": "object",
			"x-audience": "internal",
			"required": ["legacy_assets", "notes"],
			"additionalProperties": false,
			"properties": {
				"legacy_assets": { "type": "array", "items": { "type": "string" } },
				"notes": { "type": ["string", "null"] }
			}
		},
		"provenance": {
			"type": "object",
			"x-audience": "internal",
			"required": ["source_units", "figure_images"],
			"additionalProperties": false,
			"description": "Internal only; stripped from every runtime artifact",
			"properties": {
				"source_units": { "type": "array", "items": { "type": "string" } },
				"figure_images": { "type": "array", "items": { "type": "string" } }
			}
		},
		"review": {
			"type": "object",
			"x-audience": "internal",
			"description": "Mirrors concept notes: a novice reading of what the visual says, and a physics review of its model, tests and claims",
			"additionalProperties": false,
			"properties": {
				"novice": {
					"type": "object",
					"required": ["verdict", "date", "reviewed_revision", "retell_attempt", "stumbles", "fixes", "concerns"],
					"additionalProperties": false,
					"properties": {
						"verdict": { "enum": ["accurate", "fixed", "needs-attention"] },
						"date": { "$ref": "#/definitions/date" },
						"reviewed_revision": { "type": "integer", "minimum": 1 },
						"retell_attempt": { "type": "string", "description": "What the persona would say back after the entry tour, before fixes" },
						"stumbles": { "type": "array", "items": { "$ref": "#/definitions/stumble" } },
						"fixes": { "type": "array", "items": { "type": "string" } },
						"concerns": { "type": "array", "items": { "type": "string" } },
						"rereads": {
							"type": "array",
							"description": "Later readings of spoken or displayed text that another stage changed after this review",
							"items": {
								"type": "object",
								"required": ["date", "revision", "read", "stumbles", "fixes"],
								"additionalProperties": false,
								"properties": {
									"date": { "$ref": "#/definitions/date" },
									"revision": { "type": "integer", "minimum": 1 },
									"read": { "type": "array", "items": { "type": "string" } },
									"stumbles": { "type": "array", "items": { "$ref": "#/definitions/stumble" } },
									"fixes": { "type": "array", "items": { "type": "string" } }
								}
							}
						}
					}
				},
				"physics": {
					"type": "object",
					"required": ["verdict", "date", "reviewed_revision", "verification", "counterexamples", "fixes", "concerns"],
					"additionalProperties": false,
					"properties": {
						"verdict": { "enum": ["accurate", "fixed", "needs-attention"] },
						"date": { "$ref": "#/definitions/date" },
						"reviewed_revision": { "type": "integer", "minimum": 1 },
						"verification": { "type": "array", "items": { "$ref": "#/definitions/verification" } },
						"counterexamples": { "type": "array", "items": { "type": "string" }, "description": "States tried against the model and the claims, and the outcome" },
						"fixes": { "type": "array", "items": { "type": "string" } },
						"concerns": { "type": "array", "items": { "type": "string" } },
						"diff_checks": {
							"type": "array",
							"description": "Later accuracy checks of text that another stage changed after this review",
							"items": {
								"type": "object",
								"required": ["date", "revision", "verification", "fixes"],
								"additionalProperties": false,
								"properties": {
									"date": { "$ref": "#/definitions/date" },
									"revision": { "type": "integer", "minimum": 1 },
									"verification": { "type": "array", "items": { "$ref": "#/definitions/verification" } },
									"fixes": { "type": "array", "items": { "type": "string" } }
								}
							}
						}
					}
				}
			}
		}
	},
	"definitions": {
		"rung": { "enum": ["entry", "working", "formal", "research"] },
		"form": { "enum": ["static", "interactive-2d", "interactive-3d", "animation", "plot", "simulation"] },
		"kebab": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
		"date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
		"item_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
		"stumble": {
			"type": "object",
			"required": ["quote", "problem", "rewrite"],
			"additionalProperties": false,
			"properties": { "quote": { "type": "string" }, "problem": { "type": "string" }, "rewrite": { "type": "string" } }
		},
		"verification": {
			"type": "object",
			"required": ["claim", "method", "result"],
			"additionalProperties": false,
			"properties": { "claim": { "type": "string" }, "method": { "type": "string" }, "result": { "type": "string" } }
		},
		"constraint": {
			"type": ["object", "null"],
			"description": "Available only when every listed param has one of the listed values, e.g. {\"surface\": [\"tube\", \"cone\"]}"
		},
		"beat": {
			"type": "object",
			"required": ["id", "rung", "state", "animate", "await", "predict", "check", "show", "say", "describe"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/definitions/item_id" },
				"rung": { "$ref": "#/definitions/rung" },
				"state": { "type": "object", "description": "Must contain preset (a preset id); other keys override params" },
				"animate": {
					"anyOf": [
						{
							"type": "object",
							"required": ["param", "to", "seconds"],
							"additionalProperties": false,
							"properties": { "param": { "type": "string" }, "to": {}, "seconds": { "type": "number", "minimum": 0 } }
						},
						{ "type": "null" }
					]
				},
				"await": { "enum": ["none", "prediction", "learner-action"] },
				"predict": { "type": ["string", "null"], "x-format": "speech" },
				"check": { "anyOf": [{ "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/(checks|problems)/[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "null" }], "description": "Concept check or problem this beat's prediction or action evidences" },
				"show": { "type": "string", "x-format": "plain", "x-audience": "author", "description": "What is on screen, for authors" },
				"say": { "type": "string", "x-format": "speech", "description": "First person, names what is on screen (colour and line style), gives directions relative to the path, skips no step" },
				"describe": { "type": "string", "x-format": "speech", "description": "Non-visual description of the state" }
			}
		}
	}
}
